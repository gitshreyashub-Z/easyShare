PORT=5000
MONGO_URI=your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=https://easy-share-lemon.vercel.app
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
SUPABASE_BUCKET=easyShare_uploads
# Email / SMTP Configuration (for password reset OTP)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 (or 587), SMTP_USER=your-email@gmail.com, SMTP_PASS=your-16-char-app-password
# For Brevo/SendGrid/Mailgun/Resend: Use provider SMTP credentials
# In development: If omitted, OTP will be printed to server console for testing
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
EMAIL_FROM="PasteBox <no-reply@your-domain.example>"
